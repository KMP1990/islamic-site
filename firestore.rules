rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isDeveloper() {
      return request.auth != null
        && exists(/databases/$(database)/documents/settings/developer)
        && get(/databases/$(database)/documents/settings/developer).data.uid == request.auth.uid;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // settings (قراءة عامة، كتابة للمطور فقط)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isDeveloper() || (request.auth != null && docId == 'devPassword' && request.resource.data.keys().hasOnly(['hash', 'updatedAt']));
    }

    // users
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isOwner(uid) || isDeveloper();
      allow delete: if isDeveloper();
    }

    // userPrefs
    match /userPrefs/{uid} {
      allow read, write: if isOwner(uid);
    }

    // fcmTokens
    match /fcmTokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    // pushQueue
    match /pushQueue/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isDeveloper();
    }

    // news
    match /news/{docId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // ads
    match /ads/{docId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // messages
    match /messages/{docId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // bannedDevices
    match /bannedDevices/{docId} {
      allow read: if request.auth != null;
      allow write: if isDeveloper();
    }

    // friendships
    match /friendships/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // chats
    match /chats/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isDeveloper();
    }

    // chatMessages
    match /chatMessages/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // typing
    match /typing/{docId} {
      allow read, write: if request.auth != null;
    }

    // notifications
    match /notifications/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isDeveloper();
    }

    // userStatus
    match /userStatus/{uid} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid);
    }

    // analytics
    match /analytics/{uid} {
      allow read, write: if isOwner(uid) || isDeveloper();
    }
  }
}