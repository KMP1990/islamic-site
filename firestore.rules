rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================
       دوال مساعدة
       ============================================ */
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isDeveloper() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/settings/developer)
        && get(/databases/$(database)/documents/settings/developer).data.uid == request.auth.uid;
    }

    /* ============================================
       settings
       ============================================ */
    match /settings/{docId} {
      allow read: if true;
      allow write: if isDeveloper()
        || (isAuthenticated() && docId == 'devPassword'
            && request.resource.data.keys().hasOnly(['hash', 'updatedAt']));
    }

    /* ============================================
       users
       ============================================ */
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isOwner(uid) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    /* ============================================
       userPrefs
       ============================================ */
    match /userPrefs/{uid} {
      allow read, write: if isOwner(uid);
    }

    /* ============================================
       notificationSettings
       ============================================ */
    match /notificationSettings/{uid} {
      allow read: if isOwner(uid) || isAuthenticated();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAuthenticated();
    }

    /* ============================================
       fcmTokens
       ============================================ */
    match /fcmTokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    /* ============================================
       ntfyTopics
       ============================================ */
    match /ntfyTopics/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAuthenticated();
    }

    /* ============================================
       pushQueue
       ============================================ */
    match /pushQueue/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    /* ============================================
       news
       ============================================ */
    match /news/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    /* ============================================
       ads
       ============================================ */
    match /ads/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    /* ============================================
       messages
       ============================================ */
    match /messages/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    /* ============================================
       bannedDevices
       ============================================ */
    match /bannedDevices/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    /* ============================================
       friendships
       ============================================ */
    match /friendships/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    /* ============================================
       chats
       ============================================ */
    match /chats/{docId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    /* ============================================
       chatMessages
       ============================================ */
    match /chatMessages/{docId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    /* ============================================
       typing
       ============================================ */
    match /typing/{docId} {
      allow read, write: if isAuthenticated();
    }

    /* ============================================
       notifications
       ============================================ */
    match /notifications/{docId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    /* ============================================
       userStatus
       ============================================ */
    match /userStatus/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);
    }

    /* ============================================
       analytics
       ============================================ */
    match /analytics/{uid} {
      allow read, write: if isOwner(uid) || isAuthenticated();
    }

    /* ============================================
       salahSessions
       ============================================ */
    match /salahSessions/{docId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    /* ============================================
       developer
       ============================================ */
    match /developer/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    /* ============================================
       ✅ adminMessages — إشعارات إدارية
       ============================================ */
    match /adminMessages/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    /* ============================================
       ✅ adminLogs — سجل نشاطات المطور
       ============================================ */
    match /adminLogs/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    /* ============================================
       ✅ userActions — إجراءات على المستخدمين
       ============================================ */
    match /userActions/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    /* ============================================
       ✅ accountRecovery — استعادة الحسابات
       ============================================ */
    match /accountRecovery/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }
  }
}